# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/disciplineos

# JWT Secret Keys
JWT_SECRET=discipline_os_jwt_super_secret_key_2026_xyz
JWT_REFRESH_SECRET=discipline_os_refresh_secret_key_2026_abc
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# JARVIS AI Provider Configuration
# Choose ONE of the providers below or leave blank for local fallback mode.
# ==============================================================================

# Option 1: OpenAI (Default)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Google Gemini (Recommended - Fast & Free tier available)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=

# Option 3: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=

# Option 4: Local Ollama / vLLM / LMStudio (100% Free & Local)
# AI_PROVIDER=local
# AI_MODEL=llama3.2
# AI_API_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
